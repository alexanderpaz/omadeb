#!/usr/bin/env bash
# Capturas: copia al portapapeles y guarda en ~/Imágenes/Capturas.
#   omadeb-screenshot region|output|edit
set -euo pipefail

dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Capturas"
mkdir -p "$dir"
file="$dir/captura-$(date +%Y%m%d-%H%M%S).png"

case "${1:-region}" in
  region)
    area="$(slurp -d)" || exit 0
    grim -g "$area" "$file"
    ;;
  output)
    grim -o "$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')" "$file"
    ;;
  edit)
    area="$(slurp -d)" || exit 0
    grim -g "$area" - | swappy -f - -o "$file"
    [[ -f $file ]] || exit 0
    ;;
esac

wl-copy <"$file"
notify-send -u low -i "$file" "Captura copiada y guardada" "$(basename "$file")"
